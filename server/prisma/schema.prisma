generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CrmType {
  CAR
  BIKE
  WASH
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  username         String?   @unique
  password         String
  role             String    @default("user")
  allowedCrms      CrmType[] @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  profileImage     String?
  phone            String? // ⭐ ADD THIS
  companyName      String? // ⭐ ADD THIS
  // ⭐ REFERRAL FIELDS
  myReferralCode   String    @unique
  referredByCode   String?
  referredByUserId Int?

  referredByUser User?  @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals      User[] @relation("UserReferrals")

  clients        Client[]
  invoices       Invoice[]
  reminders      Reminder[]
  ocrs           OcrRecord[]
  washingClients WashingClient[]
}

model Client {
  id           Int      @id @default(autoincrement())
  fullName     String
  phone        String
  email        String?
  address      String?
  vehicleMake  String
  vehicleModel String
  vehicleYear  Int
  regNumber    String
  vin          String?
  carImage     String? // main image URL/base64 (legacy)
  adImage      String? // image used by 3D viewer / front-banner
  staffPerson  String? // legacy
  receiverName String? // NEW: person receiving vehicle
  damageImages Json? // NEW: stores array of image URLs or base64
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       Int?

  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  services  Service[]
  invoices  Invoice[]
  reminders Reminder[] // FIXED: field name should be plural and distinct
  ocrs      OcrRecord[] // <- linked OCR records

  @@unique([userId, regNumber])
  @@index([userId])
  @@index([regNumber])
}

model Service {
  id           Int      @id @default(autoincrement())
  date         DateTime
  notes        String?
  partsCost    Float?
  partsGst     Float?
  laborCost    Float?
  laborGst     Float?
  cost         Float?
  status       String?
  clientId     Int
  categoryId   Int?
  subServiceId Int?
  invoiceId    Int?

  // Relation: one Service -> many ServiceMedia
  mediaFiles ServiceMedia[]

  client     Client           @relation(fields: [clientId], references: [id])
  invoice    Invoice?         @relation(fields: [invoiceId], references: [id])
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])
  subService SubService?      @relation(fields: [subServiceId], references: [id])

  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  washingClient            WashingClient?          @relation(fields: [washingClientId], references: [id])
  washingClientId          Int?
  washingServiceCategory   WashingServiceCategory? @relation(fields: [washingServiceCategoryId], references: [id])
  washingServiceCategoryId Int?
  washingSubService        WashingSubService?      @relation(fields: [washingSubServiceId], references: [id])
  washingSubServiceId      Int?
  washingServiceMedias     WashingServiceMedia[]
}

model ServiceMedia {
  id       Int    @id @default(autoincrement())
  fileName String
  mimeType String
  data     Bytes

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])

  createdAt        DateTime        @default(now())
  updatedAt        DateTime?       @updatedAt
  washingService   WashingService? @relation(fields: [washingServiceId], references: [id])
  washingServiceId Int?
}

model Invoice {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique

  clientId Int
  userId   Int?

  totalAmount Float

  partsCost Float?
  partsGst  Float?
  laborCost Float?
  laborGst  Float?

  tax        Float @default(0)
  discount   Float @default(0)
  grandTotal Float

  paymentMode String?
  status      String    @default("Pending")
  paidAt      DateTime?
  dueDate     DateTime?

  notes String?

  // ✅ Add missing service details
  serviceCategory    String?
  serviceSubCategory String?
  serviceNotes       String?
  mechanic           String?
  vehicle            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  services        Service[]
  washingClient   WashingClient? @relation(fields: [washingClientId], references: [id])
  washingClientId Int?

  @@index([status])
  @@index([paymentMode])
}

model Reminder {
  id        Int      @id @default(autoincrement())
  clientId  Int
  userId    Int?
  message   String
  remindAt  DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/**
 * ServiceCategory and SubService unchanged
 */
model ServiceCategory {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  subServices        SubService[]
  services           Service[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  washingSubServices WashingSubService[]
  washingServices    WashingService[]
}

model SubService {
  id                       Int                     @id @default(autoincrement())
  name                     String
  categoryId               Int?
  category                 ServiceCategory?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services                 Service[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  washingServiceCategory   WashingServiceCategory? @relation(fields: [washingServiceCategoryId], references: [id])
  washingServiceCategoryId Int?
  washingServices          WashingService[]
}

model OcrRecord {
  id         Int      @id @default(autoincrement())
  rawText    String
  parsedData Json
  confidence Float?
  imageUrl   String?
  createdAt  DateTime @default(now())
  clientId   Int
  userId     Int

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model Payment {
  id String @id @default(cuid())

  // Customer Details
  customerName  String?
  companyName   String?
  email         String?
  phone         String?
  plan          String?
  billingPeriod String?
  amount        Float?

  referralCode String?
  gstNumber    String?

  // One-time order fields (not used for trial system anymore)
  paymentId String? @unique
  orderId   String? @unique
  signature String?

  // 🔥 Subscription Fields
  subscriptionId  String?   @unique
  isTrial         Boolean   @default(false)
  trialEndDate    DateTime?
  nextBillingDate DateTime?
  status          String    @default("PENDING") // PENDING | TRIAL | ACTIVE | CANCELLED

  paidAt     DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//washhing crm client schema

model WashingClient {
  id               Int              @id @default(autoincrement())
  fullName         String
  phone            String
  address          String?
  vehicleMake      String
  vehicleModel     String
  mainImage        String?
  additionalImages String[]
  userId           Int?
  createdAt        DateTime         @default(now())
  user             User?            @relation(fields: [userId], references: [id])
  services         Service[]
  invoices         Invoice[]
  washingServices  WashingService[]
}

model WashingServiceCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  subServices SubService[]
  services    Service[]
}

model WashingSubService {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  categoryId Int
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  services Service[]
}

model WashingService {
  id   Int      @id @default(autoincrement())
  date DateTime

  status ServiceStatus @default(PENDING)

  clientId Int
  client   WashingClient @relation(fields: [clientId], references: [id])

  categoryId Int
  category   ServiceCategory @relation(fields: [categoryId], references: [id])

  subServiceId Int?
  subService   SubService? @relation(fields: [subServiceId], references: [id])

  partsCost      Decimal @default(0) @db.Decimal(10, 2)
  laborCost      Decimal @default(0) @db.Decimal(10, 2)
  estimatedTotal Decimal @default(0) @db.Decimal(10, 2)

  notes String?

  media ServiceMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([categoryId])
}

model WashingServiceMedia {
  id        Int     @id @default(autoincrement())
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])

  url      String
  mimeType String?
  fileName String?

  createdAt DateTime @default(now())
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
