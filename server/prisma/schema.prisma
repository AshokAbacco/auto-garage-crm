generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CrmType {
  CAR
  BIKE
  WASH
}

enum PlanType {
  BASIC
  STANDARD
  PREMIUM
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  username    String?   @unique
  password    String
  role        String    @default("user")
  allowedCrms CrmType[] @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profileImage String?
  phone        String?
  companyName  String?

  // Subscription fields
  plan       PlanType  @default(BASIC)
  planExpiry DateTime?

  // Link to Payment (subscriptions)
  payments Payment[]

  // Referral System
  myReferralCode   String  @unique
  referredByCode   String?
  referredByUserId Int?

  referredByUser User?  @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals      User[] @relation("UserReferrals")

  clients        Client[]
  invoices       Invoice[]
  reminders      Reminder[]
  ocrs           OcrRecord[]
  bikes          Bike[]
  bikeReminders  BikeReminder[]
  washingClients WashingClient[]
  bikeOcrRecords BikeOcrRecord[]
}

model Client {
  id           Int      @id @default(autoincrement())
  fullName     String
  phone        String
  email        String?
  address      String?
  vehicleMake  String
  vehicleModel String
  vehicleYear  Int
  regNumber    String
  vin          String?
  carImage     String?
  adImage      String?
  staffPerson  String?
  receiverName String?
  damageImages Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       Int?

  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  services  Service[]
  invoices  Invoice[]
  reminders Reminder[]
  ocrs      OcrRecord[]

  @@unique([userId, regNumber])
  @@index([userId])
  @@index([regNumber])
}

model Service {
  id           Int      @id @default(autoincrement())
  date         DateTime
  notes        String?
  partsCost    Float?
  partsGst     Float?
  laborCost    Float?
  laborGst     Float?
  cost         Float?
  status       String?
  clientId     Int
  categoryId   Int?
  subServiceId Int?
  invoiceId    Int?

  mediaFiles ServiceMedia[]

  client     Client           @relation(fields: [clientId], references: [id])
  invoice    Invoice?         @relation(fields: [invoiceId], references: [id])
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])
  subService SubService?      @relation(fields: [subServiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceMedia {
  id       Int    @id @default(autoincrement())
  fileName String
  mimeType String
  data     Bytes

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Invoice {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique

  clientId Int
  userId   Int?

  totalAmount Float

  partsCost Float?
  partsGst  Float?
  laborCost Float?
  laborGst  Float?

  tax        Float @default(0)
  discount   Float @default(0)
  grandTotal Float

  paymentMode String?
  status      String    @default("Pending")
  paidAt      DateTime?
  dueDate     DateTime?

  notes String?

  serviceCategory    String?
  serviceSubCategory String?
  serviceNotes       String?
  mechanic           String?
  vehicle            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  services        Service[]
  washingClient   WashingClient? @relation(fields: [washingClientId], references: [id])
  washingClientId Int?

  @@index([status])
  @@index([paymentMode])
}

model Reminder {
  id        Int      @id @default(autoincrement())
  clientId  Int
  userId    Int?
  message   String
  remindAt  DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ServiceCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  subServices SubService[]
  services    Service[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model SubService {
  id         Int              @id @default(autoincrement())
  name       String
  categoryId Int?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services   Service[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model OcrRecord {
  id         Int      @id @default(autoincrement())
  rawText    String
  parsedData Json
  confidence Float?
  imageUrl   String?
  createdAt  DateTime @default(now())
  clientId   Int
  userId     Int

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model Payment {
  id String @id @default(cuid())

  // Link to user
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  // Customer Details
  customerName String?
  companyName  String?
  email        String?
  phone        String?

  // Plan should be enum
  plan          PlanType?
  billingPeriod String?
  amount        Float?

  referralCode String?
  gstNumber    String?

  paymentId String? @unique
  orderId   String? @unique
  signature String?

  subscriptionId  String?   @unique
  isTrial         Boolean   @default(false)
  trialEndDate    DateTime?
  nextBillingDate DateTime?
  status          String    @default("PENDING")

  paidAt     DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bike Tables

model Bike {
  id        Int     @id @default(autoincrement())
  ownerName String
  phone     String
  email     String?
  address   String?

  bikeBrand String
  bikeModel String
  bikeYear  Int?

  regNumber    String
  engineNumber String?
  vin          String?

  bikeImage    String?
  adImage      String?
  damageImages String[]

  receiverName String?
  color        String?
  fuel         String?
  notes        String?
  bikeServices BikeService[]
  userId       Int?
  user         User?         @relation(fields: [userId], references: [id])

  createdAt      DateTime        @default(now())
  bikeInvoices   BikeInvoice[]
  bikeReminders  BikeReminder[]
  bikeOcrRecords BikeOcrRecord[]
}

model BikeService {
  id Int @id @default(autoincrement())

  clientId Int
  client   Bike @relation(fields: [clientId], references: [id])

  categoryId Int
  category   BikeServiceCategory @relation(fields: [categoryId], references: [id])

  subServiceId Int
  subService   BikeSubService @relation(fields: [subServiceId], references: [id])

  date  DateTime
  notes String?

  partsCost Float @default(0)
  partsGst  Float @default(0)

  laborCost Float @default(0)
  laborGst  Float @default(0)

  cost   Float  @default(0)
  status String @default("Pending")

  invoiceId Int?
  invoice   BikeInvoice? @relation("InvoiceServices", fields: [invoiceId], references: [id])

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bikeServiceMedias BikeServiceMedia[]
}

model BikeServiceCategory {
  id   Int    @id @default(autoincrement())
  name String

  bikeBrand String? // Honda, Yamaha, etc

  subServices BikeSubService[]
  services    BikeService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BikeSubService {
  id   Int    @id @default(autoincrement())
  name String

  categoryId Int
  category   BikeServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  services BikeService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BikeServiceMedia {
  id Int @id @default(autoincrement())

  serviceId Int
  service   BikeService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  fileName String?
  mimeType String?
  data     Bytes

  createdAt DateTime @default(now())
}

model BikeInvoice {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique

  // relation to Bike (your client)
  bikeId Int
  bike   Bike @relation(fields: [bikeId], references: [id])

  // Bike service info (optional or detailed stored data)
  serviceCategory    String?
  serviceSubCategory String?
  serviceNotes       String?

  vehicle String? // bikeModel or brand if needed

  // Pricing
  partsCost Float @default(0)
  partsGst  Float @default(0)
  laborCost Float @default(0)
  laborGst  Float @default(0)
  tax       Float @default(0)
  discount  Float @default(0)

  grandTotal Float

  // Payment
  paymentMode String?
  status      String    @default("Pending")
  paidAt      DateTime?
  dueDate     DateTime?

  notes String?

  // relation to BikeService (each service inside invoice)
  services BikeService[] @relation("InvoiceServices")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BikeReminder {
  id Int @id @default(autoincrement())

  bikeClientId Int
  bike         Bike @relation(fields: [bikeClientId], references: [id], onDelete: Cascade)

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  message String

  remindDate DateTime
  remindTime String?

  isDone Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BikeOcrRecord {
  id           Int      @id @default(autoincrement())
  bikeClientId Int
  bike         Bike     @relation(fields: [bikeClientId], references: [id], onDelete: Cascade)
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawText      String // PostgreSQL TEXT (unlimited)
  parsedData   Json
  confidence   Float?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bikeClientId])
  @@index([userId])
}

// Washing CRM client schema
model WashingClient {
  id               Int      @id @default(autoincrement())
  fullName         String
  phone            String
  address          String?
  email            String?
  vehicleMake      String
  vehicleModel     String
  regNumber        String?
  mainImage        String?
  additionalImages String[]
  userId           Int?
  createdAt        DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id])
  washingServices WashingService[]
  washBillings    WashBilling[]
  invoices        Invoice[]
}

model WashingServiceCategory {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())

  subServices WashingSubService[]
  services    WashingService[]

  @@unique([name])
  @@map("washing_service_categories")
}

model WashingSubService {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  categoryId  Int
  createdAt   DateTime @default(now())

  category WashingServiceCategory @relation(fields: [categoryId], references: [id])
  services WashingService[]

  @@unique([name, categoryId])
  @@map("washing_sub_services")
}

model WashingServiceMedia {
  id Int @id @default(autoincrement())

  washingServiceId Int
  washingService   WashingService @relation(fields: [washingServiceId], references: [id], onDelete: Cascade)

  url       String
  mimeType  String?
  fileName  String?
  createdAt DateTime @default(now())

  @@map("washing_service_media")
}

model WashingService {
  id     Int           @id @default(autoincrement())
  date   DateTime
  status ServiceStatus @default(PENDING)

  clientId Int
  client   WashingClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  categoryId Int
  category   WashingServiceCategory @relation(fields: [categoryId], references: [id])

  subServiceId Int?
  subService   WashingSubService? @relation(fields: [subServiceId], references: [id])

  partsCost      Decimal @default(0) @db.Decimal(10, 2)
  partsGst       Decimal @default(0) @db.Decimal(10, 2)
  estimatedTotal Decimal @default(0) @db.Decimal(10, 2)

  notes String?

  media WashingServiceMedia[]

  /**
   * 🔗 Invoice link via JOIN table
   */
  billings WashBillingService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("washing_services")
}

model WashBilling {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique

  washingClientId Int
  userId          Int

  partsCost Decimal @default(0) @db.Decimal(10, 2)
  partsGst  Decimal @default(0) @db.Decimal(10, 2)

  grandTotal Decimal @db.Decimal(10, 2)

  paymentMode String?
  status      String    @default("PENDING")
  paidAt      DateTime?
  dueDate     DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  washingClient WashingClient        @relation(fields: [washingClientId], references: [id])
  services      WashBillingService[]

  @@index([washingClientId])
  @@map("wash_billings")
}

model WashBillingService {
  id Int @id @default(autoincrement())

  washBillingId    Int
  washingServiceId Int

  washBilling    WashBilling    @relation(fields: [washBillingId], references: [id], onDelete: Cascade)
  washingService WashingService @relation(fields: [washingServiceId], references: [id], onDelete: Cascade)

  @@unique([washBillingId, washingServiceId])
  @@map("wash_billing_services")
}