generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CrmType {
  CAR
  BIKE
  WASH
}

enum PlanType {
  BASIC
  STANDARD
  PREMIUM
}

enum SalaryStatus {
  PAID
  UNPAID
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserRole {
  USER
  TEAM_MEMBER
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  username     String? @unique
  password     String
  profileImage String?
  phone        String?
  companyName  String?

  // OWNER only
  role        String    @default("user")
  allowedCrms CrmType[] @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Subscription fields
  plan       PlanType  @default(BASIC)
  planExpiry DateTime?

  payments Payment[]

  myReferralCode   String  @unique
  referredByCode   String?
  referredByUserId Int?

  referredByUser User?  @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals      User[] @relation("UserReferrals")

  // Car
  clients          Client[]
  invoices         Invoice[]
  reminders        Reminder[]
  ocrs             OcrRecord[]
  staffMembers     CarStaff[]
  carStaffLogins   CarStaffLogin[]
  carStaffSalaries CarStaffSalary[]

  //Bike
  parentUserId          Int?
  parentUser            User?           @relation("TeamUsers", fields: [parentUserId], references: [id])
  teamUsers             User[]          @relation("TeamUsers")
  ownedBikes            Bike[]          @relation("OwnerBikes")
  createdBikes          Bike[]          @relation("CreatedBikes")
  ownedBikeServices     BikeService[]   @relation("OwnerBikeServices")
  createdBikeServices   BikeService[]   @relation("CreatedBikeServices")
  ownedBikeInvoices     BikeInvoice[]   @relation("OwnerBikeInvoices")
  createdBikeInvoices   BikeInvoice[]   @relation("CreatedBikeInvoices")
  ownedBikeReminders    BikeReminder[]  @relation("OwnerBikeReminders")
  createdBikeReminders  BikeReminder[]  @relation("CreatedBikeReminders")
  ownedBikeOcrRecords   BikeOcrRecord[] @relation("OwnerBikeOcrRecords")
  createdBikeOcrRecords BikeOcrRecord[] @relation("CreatedBikeOcrRecords")
  bikeStaffs            BikeStaff[]
  bikeTeams             BikeTeam[]

  // washing 
  washingClients WashingClient[]
  washTeamsOwned WashTeam[]      @relation("AdminWashTeams")
  // Team member → belongs to one team
  washTeamId     Int?
  washTeamMember WashTeam?       @relation("TeamMember", fields: [washTeamId], references: [id])
}

//car db schemas

model Client {
  id           Int      @id @default(autoincrement())
  fullName     String
  phone        String
  email        String?
  address      String?
  vehicleMake  String
  vehicleModel String
  vehicleYear  Int
  regNumber    String
  vin          String?
  carImage     String?
  adImage      String?
  staffPerson  String?
  receiverName String?
  damageImages Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       Int?

  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  services  Service[]
  invoices  Invoice[]
  reminders Reminder[]
  ocrs      OcrRecord[]

  @@unique([userId, regNumber])
  @@index([userId])
  @@index([regNumber])
}

// schema.prisma
model Service {
  id               Int       @id @default(autoincrement())
  date             DateTime
  notes            String?
  partsCost        Float?
  partsGst         Float?
  laborCost        Float?
  laborGst         Float?
  cost             Float?
  status           String?
  priority         String?   @default("Normal")
  serviceInDate    DateTime?
  serviceOutDate   DateTime?
  expectedDelivery DateTime?
  internalNotes    String?
  assignedMechanic String?
  advancePaid      Float?    @default(0)
  clientId         Int
  categoryId       Int?
  subServiceId     Int?
  invoiceId        Int?

  mediaFiles ServiceMedia[]

  client     Client           @relation(fields: [clientId], references: [id])
  invoice    Invoice?         @relation(fields: [invoiceId], references: [id])
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])
  subService SubService?      @relation(fields: [subServiceId], references: [id])

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  serviceCostItems ServiceCostItem[]
}

model ServiceMedia {
  id       Int    @id @default(autoincrement())
  fileName String
  mimeType String
  data     Bytes

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Invoice {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique

  clientId Int
  userId   Int?

  tax        Float @default(0)
  discount   Float @default(0)
  grandTotal Float

  paymentMode String?
  status      String    @default("Pending")
  paidAt      DateTime?
  dueDate     DateTime?

  notes String?

  serviceCategory    String?
  serviceSubCategory String?
  serviceNotes       String?
  mechanic           String?
  vehicle            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  services         Service[]
  washingClient    WashingClient?    @relation(fields: [washingClientId], references: [id])
  washingClientId  Int?
  invoiceCostItems InvoiceCostItem[]

  @@index([status])
  @@index([paymentMode])
}

model InvoiceCostItem {
  id        Int @id @default(autoincrement())
  invoiceId Int

  type String // "part" | "labor"
  name String

  quantity  Int
  unitPrice Float

  cgstRate Float
  sgstRate Float

  totalCost Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ServiceCostItem {
  id        Int @id @default(autoincrement())
  serviceId Int

  type      String // "part" | "labor"
  name      String
  quantity  Int
  unitPrice Float

  cgstRate  Float?
  sgstRate  Float?
  totalCost Float

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Reminder {
  id        Int      @id @default(autoincrement())
  clientId  Int
  userId    Int?
  message   String
  remindAt  DateTime
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ServiceCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  subServices SubService[]
  services    Service[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model SubService {
  id         Int              @id @default(autoincrement())
  name       String
  categoryId Int?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services   Service[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model OcrRecord {
  id         Int      @id @default(autoincrement())
  rawText    String
  parsedData Json
  confidence Float?
  imageUrl   String?
  createdAt  DateTime @default(now())
  clientId   Int
  userId     Int

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model CarStaff {
  id Int @id @default(autoincrement())

  // Owner relationship
  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Basic staff info
  name     String
  role     String? // Mechanic, Manager, Helper
  phone    String?
  joinDate DateTime @default(now())

  // Salary configuration
  baseSalary        Float @default(0)
  bonus             Float @default(0)
  leaves            Int   @default(0)
  deductionPerLeave Float @default(0)
  extraDeductions   Float @default(0)

  // Relations
  login CarStaffLogin?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  carStaffSalaries CarStaffSalary[]

  @@index([ownerId])
}

model CarStaffLogin {
  id Int @id @default(autoincrement())

  // Relations
  staffId Int      @unique
  staff   CarStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Login credentials
  email    String  @unique
  password String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model CarStaffSalary {
  id Int @id @default(autoincrement())

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  staffId Int
  staff   CarStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  month Int // 1 - 12
  year  Int

  // 🔒 Snapshot of salary configuration
  baseSalary        Float
  bonus             Float
  leaves            Int
  deductionPerLeave Float
  extraDeductions   Float

  // 💵 Final computed values (stored, never recalculated)
  netSalary Float

  status SalaryStatus @default(UNPAID)
  paidAt DateTime?

  createdAt DateTime @default(now())

  @@unique([staffId, month, year]) // prevent duplicate payroll
}

model Payment {
  id String @id @default(cuid())

  // Link to user
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  // Customer Details
  customerName String?
  companyName  String?
  email        String?
  phone        String?

  // Plan should be enum
  plan          PlanType?
  billingPeriod String?
  amount        Float?

  referralCode String?
  gstNumber    String?

  paymentId String? @unique
  orderId   String? @unique
  signature String?

  subscriptionId  String?   @unique
  isTrial         Boolean   @default(false)
  trialEndDate    DateTime?
  nextBillingDate DateTime?
  status          String    @default("PENDING")

  paidAt     DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bike Tables

model Bike {
  id Int @id @default(autoincrement())

  ownerName String
  phone     String
  email     String?
  address   String?

  bikeBrand String
  bikeModel String
  bikeYear  Int?

  regNumber    String
  engineNumber String?
  vin          String?

  bikeImage    String?
  adImage      String?
  damageImages String[]

  receiverName String?
  color        String?
  fuel         String?
  notes        String?

  /**
   * 🔐 OWNERSHIP (USER BASED)
   */
  ownerUserId Int
  createdById Int

  ownerUser User @relation("OwnerBikes", fields: [ownerUserId], references: [id])
  createdBy User @relation("CreatedBikes", fields: [createdById], references: [id])

  /**
   * 🔗 RELATIONS
   */
  bikeServices   BikeService[]
  bikeInvoices   BikeInvoice[]
  bikeReminders  BikeReminder[]
  bikeOcrRecords BikeOcrRecord[]

  createdAt DateTime @default(now())

  @@index([ownerUserId])
  @@index([createdById])
}

model BikeService {
  id Int @id @default(autoincrement())

  clientId Int
  client   Bike @relation(fields: [clientId], references: [id], onDelete: Cascade)

  categoryId Int
  category   BikeServiceCategory @relation(fields: [categoryId], references: [id])

  subServiceId Int
  subService   BikeSubService @relation(fields: [subServiceId], references: [id])

  date  DateTime
  notes String?

  partsCost Float @default(0)
  partsGst  Float @default(0)
  laborCost Float @default(0)
  laborGst  Float @default(0)

  cost   Float  @default(0)
  status String @default("Pending")

  invoiceId Int?
  invoice   BikeInvoice? @relation("InvoiceServices", fields: [invoiceId], references: [id])

  ownerUserId Int
  createdById Int

  ownerUser User @relation("OwnerBikeServices", fields: [ownerUserId], references: [id])
  createdBy User @relation("CreatedBikeServices", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bikeServiceMedias BikeServiceMedia[]

  @@index([ownerUserId])
  @@index([createdById])
  @@index([clientId])
  @@index([invoiceId])
}

model BikeInvoice {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique

  bikeId    Int
  bike      Bike    @relation(fields: [bikeId], references: [id])
  vehicle   String?
  partsCost Float   @default(0)
  partsGst  Float   @default(0)
  laborCost Float   @default(0)
  laborGst  Float   @default(0)
  tax       Float   @default(0)
  discount  Float   @default(0)

  grandTotal Float

  paymentMode String?
  status      String    @default("Pending")
  paidAt      DateTime?
  dueDate     DateTime?

  ownerUserId Int
  createdById Int

  ownerUser User @relation("OwnerBikeInvoices", fields: [ownerUserId], references: [id])
  createdBy User @relation("CreatedBikeInvoices", fields: [createdById], references: [id])

  services BikeService[] @relation("InvoiceServices")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([createdById])
  @@index([bikeId])
}

model BikeReminder {
  id Int @id @default(autoincrement())

  bikeClientId Int
  bike         Bike @relation(fields: [bikeClientId], references: [id], onDelete: Cascade)

  ownerUserId Int
  createdById Int?

  ownerUser User  @relation("OwnerBikeReminders", fields: [ownerUserId], references: [id])
  createdBy User? @relation("CreatedBikeReminders", fields: [createdById], references: [id])

  message    String
  remindDate DateTime
  remindTime String?
  isDone     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([createdById])
  @@index([bikeClientId])
}

model BikeOcrRecord {
  id Int @id @default(autoincrement())

  bikeClientId Int
  bike         Bike @relation(fields: [bikeClientId], references: [id], onDelete: Cascade)

  ownerUserId Int
  createdById Int?

  ownerUser User  @relation("OwnerBikeOcrRecords", fields: [ownerUserId], references: [id])
  createdBy User? @relation("CreatedBikeOcrRecords", fields: [createdById], references: [id])

  rawText    String
  parsedData Json
  confidence Float?
  imageUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BikeServiceCategory {
  id   Int    @id @default(autoincrement())
  name String

  bikeBrand String? // Honda, Yamaha, etc

  subServices BikeSubService[]
  services    BikeService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BikeSubService {
  id   Int    @id @default(autoincrement())
  name String

  categoryId Int
  category   BikeServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  services BikeService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BikeServiceMedia {
  id Int @id @default(autoincrement())

  serviceId Int
  service   BikeService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  fileName String?
  mimeType String?
  data     Bytes

  createdAt DateTime @default(now())
}

model BikeStaff {
  id            Int                 @id @default(autoincrement())
  // 🔗 Owner (Admin/User who created staff)
  userId        Int
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 👤 Staff details
  name          String
  role          String
  // 💰 Salary fields
  baseSalary    Float
  bonus         Float               @default(0)
  leaves        Int                 @default(0)
  deductions    Float               @default(0)
  // 📅 Status tracking
  joiningDate   DateTime
  status        String              @default("pending") // pending | paid
  lastPaid      DateTime?
  // 🔗 Salary history
  salaryHistory BikeSalaryHistory[]
  // ⏱️ Meta
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  bikeTeams     BikeTeam[]
}

model BikeSalaryHistory {
  id          Int       @id @default(autoincrement())
  // 🔗 Staff reference
  bikeStaffId Int
  staff       BikeStaff @relation(fields: [bikeStaffId], references: [id], onDelete: Cascade)
  // 🗓️ Salary snapshot
  month       String // "Sep 2025"
  baseSalary  Float
  bonus       Float
  deductions  Float
  netSalary   Float
  // 💸 Payment info
  paidDate    DateTime
  createdAt   DateTime  @default(now())
}

// Bike TeamUsers login

model BikeTeam {
  id Int @id @default(autoincrement())

  // 🔗 Owner (Garage / Admin User)
  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // 👤 Employee profile
  name        String
  role        String? // Mechanic, Manager, Helper
  phone       String?
  joiningDate DateTime @default(now())

  // 🔐 Optional login
  login BikeTeamLogin?

  // 🔗 Salary profile
  staff BikeStaff? @relation(fields: [bikeStaffId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bikeStaffId Int?

  @@index([ownerId])
}

model BikeTeamLogin {
  id Int @id @default(autoincrement())

  bikeTeamId Int      @unique
  team       BikeTeam @relation(fields: [bikeTeamId], references: [id], onDelete: Cascade)

  username String  @unique
  password String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Washing CRM client schema
model WashingClient {
  id               Int      @id @default(autoincrement())
  fullName         String
  phone            String
  address          String?
  email            String?
  vehicleMake      String
  vehicleModel     String
  regNumber        String?
  mainImage        String?
  additionalImages String[]
  userId           Int?
  createdAt        DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id])
  washingServices WashingService[]
  washBillings    WashBilling[]
  invoices        Invoice[]
}

model WashingServiceCategory {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())

  subServices WashingSubService[]
  services    WashingService[]

  @@unique([name])
  @@map("washing_service_categories")
}

model WashingSubService {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  categoryId  Int
  createdAt   DateTime @default(now())

  category WashingServiceCategory @relation(fields: [categoryId], references: [id])
  services WashingService[]

  @@unique([name, categoryId])
  @@map("washing_sub_services")
}

model WashingServiceMedia {
  id Int @id @default(autoincrement())

  washingServiceId Int
  washingService   WashingService @relation(fields: [washingServiceId], references: [id], onDelete: Cascade)

  url       String
  mimeType  String?
  fileName  String?
  createdAt DateTime @default(now())

  @@map("washing_service_media")
}

model WashingService {
  id     Int           @id @default(autoincrement())
  date   DateTime
  status ServiceStatus @default(PENDING)

  clientId Int
  client   WashingClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  categoryId Int
  category   WashingServiceCategory @relation(fields: [categoryId], references: [id])

  subServiceId Int?
  subService   WashingSubService? @relation(fields: [subServiceId], references: [id])

  partsCost      Decimal @default(0) @db.Decimal(10, 2)
  partsGst       Decimal @default(0) @db.Decimal(10, 2)
  estimatedTotal Decimal @default(0) @db.Decimal(10, 2)

  notes String?

  media WashingServiceMedia[]

  /**
   * 🔗 Invoice link via JOIN table
   */
  billings WashBillingService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("washing_services")
}

model WashBilling {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique

  washingClientId Int
  userId          Int

  partsCost Decimal @default(0) @db.Decimal(10, 2)
  partsGst  Decimal @default(0) @db.Decimal(10, 2)

  grandTotal Decimal @db.Decimal(10, 2)

  paymentMode String?
  status      String    @default("PENDING")
  paidAt      DateTime?
  dueDate     DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  washingClient WashingClient        @relation(fields: [washingClientId], references: [id])
  services      WashBillingService[]

  @@index([washingClientId])
  @@map("wash_billings")
}

model WashBillingService {
  id Int @id @default(autoincrement())

  washBillingId    Int
  washingServiceId Int

  washBilling    WashBilling    @relation(fields: [washBillingId], references: [id], onDelete: Cascade)
  washingService WashingService @relation(fields: [washingServiceId], references: [id], onDelete: Cascade)

  @@unique([washBillingId, washingServiceId])
  @@map("wash_billing_services")
}

model WashTeam {
  id   Int    @id @default(autoincrement())
  name String

  // Display / contact email only
  email String @unique

  // Admin who created the team
  createdBy Int
  admin     User @relation("AdminWashTeams", fields: [createdBy], references: [id])

  // Team members
  members User[] @relation("TeamMember")

  createdAt DateTime @default(now())
}
